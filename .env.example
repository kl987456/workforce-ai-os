# Postgres connection string (provisioned automatically via Vercel + Neon marketplace integration)
DATABASE_URL=

# Hunar Voice AI — https://api.voice.hunar.ai/docs/external/
# NEVER commit a real key. Get one from your Hunar dashboard.
HUNAR_API_KEY=
HUNAR_API_BASE_URL=https://api.voice.hunar.ai/external/v1

# Public base URL of this deployment. Hunar webhooks (call_status_updated,
# call_recording_done, call_result_done, call_summary) are posted to
# ${APP_BASE_URL}/api/webhooks/hunar — must be a real HTTPS URL Hunar's
# servers can reach, so localhost only works via a tunnel (e.g. ngrok).
APP_BASE_URL=http://localhost:3000
